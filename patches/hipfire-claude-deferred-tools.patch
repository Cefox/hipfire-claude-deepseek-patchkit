     #[test]
+    fn deferred_tool_reference_round_trip_keeps_count_and_generate_identical() {
+        let body = json!({
+            "model":"m", "max_tokens":1,
+            "tools":[
+                {"name":"ToolSearch", "input_schema":{"type":"object"}},
+                {"name":"WebSearch", "defer_loading":true,
+                 "description":"Search the web", "input_schema":{"type":"object"}},
+                {"name":"UnusedMcpTool", "defer_loading":true,
+                 "description":"unused documentation".repeat(10000),
+                 "input_schema":{"type":"object"}}
+            ],
+            "messages":[
+                {"role":"user", "content":"hi"},
+                {"role":"assistant", "content":[{"type":"tool_use", "id":"search1",
+                    "name":"ToolSearch", "input":{"query":"select:WebSearch"}}]},
+                {"role":"user", "content":[{"type":"tool_result", "tool_use_id":"search1",
+                    "content":[{"type":"tool_reference", "tool_name":"WebSearch"}]},
+                    {"type":"text", "text":"Tool loaded."}]}
+            ]
+        });
+        let generated = lower_request(&body).unwrap().chat;
+        assert_eq!(lower_count_request(&body).unwrap(), generated);
+        let tools = generated["tools"].as_array().unwrap();
+        assert_eq!(tools.len(), 2);
+        assert_eq!(tools[1]["function"]["name"], "WebSearch");
+        assert!(generated["messages"][2]["content"]
+            .as_str()
+            .unwrap()
+            .contains("WebSearch"));
+        assert!(!generated.to_string().contains("unused documentation"));
+    }
