+
+/// Client ToolSearch returns references, not full schemas. Keep unselected
+/// deferred definitions out of both counting and generation; otherwise a
+/// discovery round trip can silently expand hundreds of MCP tools.
+fn referenced_tools(messages: &[Value]) -> Result<BTreeSet<String>, String> {
+    let mut names = BTreeSet::new();
+    for (at, message) in messages.iter().enumerate() {
+        if message.get("role").and_then(Value::as_str) != Some("user") {
+            continue;
+        }
+        let Some(blocks) = message.get("content").and_then(Value::as_array) else {
+            continue;
+        };
+        for (j, block) in blocks.iter().enumerate() {
+            if block.get("type").and_then(Value::as_str) != Some("tool_result")
+                || block.get("is_error").and_then(Value::as_bool) == Some(true)
+            {
+                continue;
+            }
+            let Some(parts) = block.get("content").and_then(Value::as_array) else {
+                continue;
+            };
+            for (k, part) in parts.iter().enumerate() {
+                if part.get("type").and_then(Value::as_str) == Some("tool_reference") {
+                    let path = format!("messages.{at}.content.{j}.content.{k}");
+                    names.insert(tool_reference_name(part, &path)?.to_owned());
+                }
+            }
+        }
+    }
+    Ok(names)
+}
