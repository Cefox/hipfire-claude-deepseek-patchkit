     #[test]
+    fn search_settings_are_visible_with_configured_values_in_advanced() {
+        let (paths, root) = fixture_home("deepseek-search-settings");
+        let key_file = root.join("deepseek-api-key");
+        let config = format!(
+            "[serve]\ndeepseek_api_key_file = {:?}\ndeepseek_search_url = \"https://api.deepseek.com/v1/tools/search\"\n",
+            key_file.to_str().unwrap()
+        );
+        write_config(&paths, &config);
+        let model = build(
+            &paths,
+            &registry(CARD),
+            &arch("gfx1151", A8Prefill::NotLanded),
+            &ConfigLayer::default(),
+        );
+        let hits = model.search(&RowFilter {
+            search: "deepseek".into(),
+            ..RowFilter::default()
+        });
+        for (key, title, value) in [
+            ("serve.deepseek_api_key_file", "DeepSeek Search key file", key_file.to_str().unwrap()),
+            ("serve.deepseek_search_url", "DeepSeek Search API URL", "https://api.deepseek.com/v1/tools/search"),
+        ] {
+            let setting = row(&model, key);
+            assert_eq!(setting.group, Intent::Advanced);
+            assert_eq!(setting.title, title);
+            assert_eq!(setting.display, value);
+            assert!(!setting.is_unused());
+            assert!(hits.iter().any(|hit| hit.id == RowId::Key(key.into())));
+        }
+        let _ = std::fs::remove_dir_all(root);
+    }
