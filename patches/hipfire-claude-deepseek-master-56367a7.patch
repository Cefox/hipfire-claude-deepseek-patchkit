+/// Render a locally executed server-tool loop with Anthropic's native server
+/// tool blocks. `server_blocks` contains alternating call/result objects.
+pub(crate) fn message_json_with_server_blocks(
+    completion: &Completion,
+    server_blocks: &[Value],
+) -> Value {
+    let mut message = message_json(completion);
+    let mut content = server_blocks.to_vec();
+    if let Some(existing) = message.get("content").and_then(Value::as_array) {
+        content.extend(existing.iter().cloned());
+    }
+    message["content"] = Value::Array(content);
+    let count = server_blocks
+        .iter()
+        .filter(|block| block.get("type").and_then(Value::as_str) == Some("web_search_tool_result"))
+        .count();
+    if count > 0 {
+        message["usage"]["server_tool_use"]["web_search_requests"] = json!(count);
+    }
+    message
+}
