+/// Count with the same input projection as Messages generation, but never
+/// create a generation transaction or reset/load the resident model.
+async fn handle_count_tokens(
+    req: Request<Incoming>,
+    shared: Arc<ServeShared>,
+) -> Response<BoxBody> {
+    let api = WireApi::AnthropicMessages;
+    let max_bytes = shared.max_request_bytes;
+    if req
+        .headers()
+        .get(header::CONTENT_LENGTH)
+        .and_then(|v| v.to_str().ok())
+        .and_then(|v| v.parse::<u64>().ok())
+        .is_some_and(|n| n > max_bytes)
+    {
+        return api.error_response(&format!("request body exceeds {max_bytes} bytes"), 413);
+    }
+    let body = match read_json_body(req.into_body(), max_bytes).await {
+        Ok(body) => body,
+        Err(error) => {
+            let message = error.to_string();
+            let status = if message.contains("exceeds") {
+                413
+            } else {
+                400
+            };
+            return api.error_response(&message, status);
+        }
+    };
+    let body = match anthropic::lower_count_request(&body) {
+        Ok(body) => body,
+        Err(message) => return api.error_response(&message, 400),
+    };
+    if let Err(error) = gate_endpoint_tools(&body, api.adapter_kind()) {
+        return api.error_response(&error.to_string(), 400);
+    }
+    let mut cancel_guard = CancelOnDrop::new();
+    let guard = match shared.admission.acquire_async(cancel_guard.token()).await {
+        Ok(guard) => guard,
+        Err(error) => return admission_error_response(api, &shared.metrics, &error),
+    };
+    let worker_shared = Arc::clone(&shared);
+    let result = tokio::task::spawn_blocking(move || {
+        // The permit belongs to the worker even if the HTTP client leaves.
+        // Engine::request has one control slot, so counts must serialize with
+        // other control-plane and generation operations.
+        let _guard = guard;
+        crate::serve::complete::count_tokens_request(&worker_shared, &body)
+    })
+    .await;
+    cancel_guard.disarm();
+    match result {
+        Ok(Ok(body)) => json_response(body, 200),
+        Ok(Err(error)) => api.error_response(&error.to_string(), request_error_status(&error)),
+        Err(error) => api.error_response(&format!("count_tokens worker failed: {error}"), 500),
+    }
+}
