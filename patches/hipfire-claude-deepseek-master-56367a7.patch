+fn web_search_config(tools: &Value) -> Result<Value, String> {
+    let tool = tools
+        .as_array()
+        .and_then(|items| {
+            items.iter().find(|tool| {
+                matches!(
+                    tool.get("type").and_then(Value::as_str),
+                    Some("web_search_20250305" | "web_search_20260209" | "web_search_20260318")
+                )
+            })
+        })
+        .ok_or_else(|| "native web search configuration is missing".to_owned())?;
+    let mut config = Map::new();
+    for key in ["max_uses", "allowed_domains", "blocked_domains"] {
+        if let Some(value) = tool.get(key) {
+            config.insert(key.to_owned(), value.clone());
+        }
+    }
+    if config.contains_key("allowed_domains") && config.contains_key("blocked_domains") {
+        return Err("native web search cannot set both allowed_domains and blocked_domains".into());
+    }
+    if let Some(max_uses) = config.get("max_uses") {
+        if max_uses.as_u64().is_none_or(|n| n == 0 || n > 64) {
+            return Err("native web search max_uses must be between 1 and 64".into());
+        }
+    }
+    for key in ["allowed_domains", "blocked_domains"] {
+        if let Some(domains) = config.get(key) {
+            let domains = domains
+                .as_array()
+                .ok_or_else(|| format!("native web search {key} must be an array"))?;
+            if domains.len() > 32
+                || domains.iter().any(|domain| {
+                    domain.as_str().is_none_or(|domain| {
+                        domain.is_empty()
+                            || domain.len() > 253
+                            || domain.contains("://")
+                            || domain.chars().any(char::is_whitespace)
+                    })
+                })
+            {
+                return Err(format!("native web search {key} contains invalid domains"));
+            }
+        }
+    }
+    Ok(Value::Object(config))
+}
