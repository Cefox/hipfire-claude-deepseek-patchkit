+/// Count a projected Qwen4 request using the production renderer. The count
+/// path is read-only: assistant-history lookups operate on a private cache
+/// clone and never touch the resident conversation or model state.
+pub fn count_qwen4_prompt_tokens(
+    m: &LoadedModel,
+    msg: &serde_json::Value,
+) -> Result<usize, String> {
+    if m.arch_id != 16 {
+        return Err("count_tokens currently supports the native Qwen4 text route only".into());
+    }
+    if ["image", "image_base64"]
+        .iter()
+        .any(|key| msg.get(*key).is_some_and(|value| !value.is_null()))
+    {
+        return Err("count_tokens does not support image inputs".into());
+    }
+    if !qwen4_jinja_enabled() || m.chat_template.is_none() || m.tokenizer.is_none() {
+        return Err(
+            "count_tokens requires the loaded Qwen4 tokenizer and Jinja chat template".into(),
+        );
+    }
+
+    let prompt = msg
+        .get("prompt")
+        .and_then(serde_json::Value::as_str)
+        .unwrap_or("Hello");
+    let prompt = hipfire_runtime::tokenizer::maybe_normalize_prompt(prompt);
+    let system = msg.get("system").and_then(serde_json::Value::as_str);
+    let messages = hipfire_engine::prompt::parse_generate_messages(msg)?;
+    let tools: Option<Vec<serde_json::Value>> = msg
+        .get("tools")
+        .map(|value| {
+            serde_json::from_value(value.clone()).map_err(|error| format!("invalid tools: {error}"))
+        })
+        .transpose()?
+        .filter(|value: &Vec<_>| !value.is_empty());
+    let max_think = msg
+        .get("max_think_tokens")
+        .and_then(serde_json::Value::as_u64)
+        .unwrap_or(0) as usize;
+    let (thinking, effort) = qwen_jinja_reasoning(
+        msg.get("thinking_enabled")
+            .and_then(serde_json::Value::as_bool),
+        msg.get("reasoning_effort")
+            .or_else(|| msg.get("thinking_mode"))
+            .and_then(serde_json::Value::as_str),
+        max_think,
+    );
+    let prefix = match msg
+        .get("assistant_prefix")
+        .and_then(serde_json::Value::as_str)
+        .unwrap_or("plain")
+    {
+        "open_think" => hipfire_runtime::prompt_frame::AssistantPrefix::OpenThink,
+        "closed_think" => hipfire_runtime::prompt_frame::AssistantPrefix::ClosedThink,
+        _ => hipfire_runtime::prompt_frame::AssistantPrefix::Plain,
+    };
+
+    let (cold, _) = render_qwen4_prompt_cold(
+        m,
+        Qwen4PromptRoute::Ar,
+        system,
+        &prompt,
+        prefix,
+        tools.as_deref(),
+        messages.as_deref(),
+        thinking,
+        effort.as_deref(),
+    )
+    .map_err(|(message, _)| message)?;
+    let Some(history) = messages.as_deref() else {
+        return Ok(cold.len());
+    };
+
+    let tokenizer = m.tokenizer.as_ref().expect("validated Qwen4 tokenizer");
+    let template = m
+        .chat_template
+        .as_deref()
+        .expect("validated Jinja template");
+    let frame = hipfire_runtime::prompt_frame::JinjaChatFrame {
+        tokenizer,
+        template,
+        system,
+        user: &prompt,
+        enable_thinking: thinking,
+        bos_token: None,
+        reasoning_strength: None,
+        reasoning_effort: effort.as_deref(),
+    };
+    let mut cache = m.asst_turn_cache.clone();
+    let tokens = qwen_jinja_cached_history_tokens(
+        &frame,
+        &mut cache,
+        &cold,
+        history,
+        tools.as_deref(),
+        hipfire_runtime::prompt_frame::ToolTurnSplice::WholeBody,
+        "qwen4-count",
+        Some(&m.conversation_tokens),
+    )?;
+    Ok(tokens.len())
+}
