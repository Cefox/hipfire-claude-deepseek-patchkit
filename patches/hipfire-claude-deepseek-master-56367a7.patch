+    #[test]
+    fn ccswitch_request_key_authenticates_a_local_search_request() {
+        use std::io::{Read, Write};
+        use std::net::TcpListener;
+        use std::thread;
+
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap();
+        let server = thread::spawn(move || {
+            let (mut stream, _) = listener.accept().unwrap();
+            let mut received = Vec::new();
+            let mut chunk = [0u8; 4096];
+            loop {
+                let read = stream.read(&mut chunk).unwrap();
+                if read == 0 {
+                    break;
+                }
+                received.extend_from_slice(&chunk[..read]);
+                let Some(header_end) = received.windows(4).position(|window| window == b"\r\n\r\n")
+                else {
+                    continue;
+                };
+                let headers = String::from_utf8_lossy(&received[..header_end]);
+                let content_length = headers
+                    .lines()
+                    .find_map(|line| {
+                        let (name, value) = line.split_once(':')?;
+                        name.eq_ignore_ascii_case("content-length")
+                            .then(|| value.trim().parse::<usize>().ok())
+                            .flatten()
+                    })
+                    .unwrap_or(0);
+                if received.len() >= header_end + 4 + content_length {
+                    break;
+                }
+            }
+            let request = String::from_utf8_lossy(&received).into_owned();
+            let response_body = r#"{"results":[{"title":"Local test","url":"https://example.test","summary":"Mock result"}]}"#;
+            write!(
+                stream,
+                "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
+                response_body.len(),
+                response_body
+            )
+            .unwrap();
+            request
+        });
+
+        let url = format!("http://{address}/v1/tools/search");
+        let (blocks, text) = search_content_at(
+            "HipFire local test",
+            &json!({}),
+            Some("ccswitch-test-secret"),
+            &url,
+        )
+        .unwrap();
+        assert_eq!(blocks[0]["title"], "Local test");
+        assert!(text.contains("Mock result"));
+
+        let request = server.join().unwrap();
+        let authorization = request
+            .lines()
+            .find(|line| {
+                line.split_once(':')
+                    .is_some_and(|(name, _)| name.eq_ignore_ascii_case("authorization"))
+            })
+            .unwrap();
+        assert!(authorization.ends_with("Bearer ccswitch-test-secret"));
+        let body = request.split_once("\r\n\r\n").unwrap().1;
+        assert!(!body.contains("ccswitch-test-secret"));
+    }
+}
