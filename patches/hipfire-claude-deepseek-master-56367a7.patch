+fn has_native_web_search(body: &serde_json::Value) -> bool {
+    body.get("tools")
+        .and_then(serde_json::Value::as_array)
+        .is_some_and(|tools| {
+            tools.iter().any(|tool| {
+                tool.pointer("/function/name")
+                    .and_then(serde_json::Value::as_str)
+                    == Some(web_search::INTERNAL_TOOL_NAME)
+            })
+        })
+}
+
+/// Complete native searches that Claude deferred because the same assistant
+/// turn also contained client tools. Anthropic returns the client tool results
+/// in the next request; insert the server result alongside those results before
+/// asking the local model to continue.
+#[allow(clippy::too_many_arguments)]
+fn resolve_pending_web_searches(
+    body: &mut serde_json::Value,
+    config: &serde_json::Value,
+    request_key: Option<&str>,
+    server_blocks: &Arc<Mutex<Vec<serde_json::Value>>>,
+    search_uses: &mut usize,
+    search_index: &mut usize,
+    mut event_callback: impl FnMut(&serde_json::Value) -> Result<(), hipfire_client::ClientError>,
+) -> Result<()> {
+    let messages = body
+        .get_mut("messages")
+        .and_then(serde_json::Value::as_array_mut)
+        .ok_or_else(|| anyhow!("native web search request lost its message history"))?;
+    let resolved_ids: Vec<String> = messages
+        .iter()
+        .filter(|message| message.get("role").and_then(serde_json::Value::as_str) == Some("tool"))
+        .filter_map(|message| {
+            message
+                .get("tool_call_id")
+                .and_then(serde_json::Value::as_str)
+                .map(str::to_owned)
+        })
+        .collect();
+    let mut resolved = Vec::with_capacity(messages.len() + 2);
+    for message in messages.drain(..) {
+        let pending_calls: Vec<serde_json::Value> =
+            if message.get("role").and_then(serde_json::Value::as_str) == Some("assistant") {
+                message
+                    .get("tool_calls")
+                    .and_then(serde_json::Value::as_array)
+                    .into_iter()
+                    .flatten()
+                    .filter(|call| {
+                        call.pointer("/function/name")
+                            .and_then(serde_json::Value::as_str)
+                            == Some(web_search::INTERNAL_TOOL_NAME)
+                    })
+                    .cloned()
+                    .collect()
+            } else {
+                Vec::new()
+            };
+        resolved.push(message);
+        for call in pending_calls {
+            let call_id = call
+                .get("id")
+                .and_then(serde_json::Value::as_str)
+                .ok_or_else(|| anyhow!("pending native web search is missing its id"))?;
+            if resolved_ids
+                .iter()
+                .any(|resolved_id| resolved_id == call_id)
+            {
+                continue;
+            }
+            let arguments = call
+                .pointer("/function/arguments")
+                .and_then(serde_json::Value::as_str)
+                .and_then(|arguments| serde_json::from_str::<serde_json::Value>(arguments).ok())
+                .or_else(|| call.pointer("/function/arguments").cloned())
+                .unwrap_or_else(|| serde_json::json!({}));
+            let output = if *search_uses >= web_search::max_uses(config) {
+                web_search::max_uses_exceeded(call_id, &arguments)
+            } else {
+                *search_uses += 1;
+                web_search::execute(call_id, &arguments, config, request_key)
+            };
+            *search_index += 1;
+            {
+                let mut blocks = server_blocks
+                    .lock()
+                    .unwrap_or_else(|error| error.into_inner());
+                // The call was already returned to Claude Code in the prior
+                // response; only its result belongs in this response.
+                blocks.push(output.result_block.clone());
+            }
+            event_callback(&serde_json::json!({
+                "type":"hipfire_server_tool_block", "block":output.result_block
+            }))?;
+            resolved.push(serde_json::json!({
+                "role":"tool", "tool_call_id":call_id, "content":output.model_result
+            }));
+        }
+    }
+    *messages = resolved;
+    Ok(())
+}
+
+/// Execute Claude native web-search calls on the gateway, then resume the
+/// resident model with DeepSeek's results until it produces a final answer or
+/// asks the client to execute an ordinary function tool.
+#[allow(clippy::too_many_arguments)]
+fn complete_anthropic_with_web_search(
+    shared: &ServeShared,
+    initial_body: serde_json::Value,
+    initial_guard: AdmissionGuard,
+    request_key: Option<&str>,
+    request_identity: Option<(String, u64)>,
+    cancelled: &std::sync::atomic::AtomicBool,
+    server_blocks: Arc<Mutex<Vec<serde_json::Value>>>,
+    mut event_callback: impl FnMut(&serde_json::Value) -> Result<(), hipfire_client::ClientError>,
+    mut terminal_callback: impl FnMut(&Completion) -> Result<(), hipfire_client::ClientError>,
+) -> Result<Completion> {
+    let eligible = initial_guard.is_eligible();
+    let model = initial_body
+        .get("model")
+        .and_then(serde_json::Value::as_str)
+        .map(str::to_owned);
+    let config = initial_body
+        .get("_hipfire_web_search_config")
+        .cloned()
+        .unwrap_or_else(|| serde_json::json!({}));
+    let max_uses = web_search::max_uses(&config);
+    let root_id = request_identity
+        .as_ref()
+        .map(|(id, _)| id.clone())
+        .unwrap_or_else(request_id);
+    let mut body = initial_body;
+    let mut next_guard = Some(initial_guard);
+    let mut search_uses = 0usize;
+    let mut search_index = 0usize;
+    let mut turns = 0usize;
+
+    resolve_pending_web_searches(
+        &mut body,
+        &config,
+        request_key,
+        &server_blocks,
+        &mut search_uses,
+        &mut search_index,
+        &mut event_callback,
+    )?;
+
+    loop {
+        if cancelled.load(std::sync::atomic::Ordering::Relaxed) {
+            return Err(anyhow!("request cancelled"));
+        }
+        turns += 1;
+        if turns > 66 {
+            return Err(anyhow!(
+                "native web search exceeded the maximum server-side tool loop"
+            ));
+        }
+        let completion = complete_request_cancellable(
+            shared,
+            &body,
+            next_guard
+                .take()
+                .ok_or_else(|| anyhow!("server tool loop lost its admission permit"))?,
+            request_identity.clone(),
+            cancelled,
+            |event| event_callback(event),
+            |_completion| Ok(()),
+        )?;
+        let server_calls: Vec<_> = completion
+            .tool_calls
+            .iter()
+            .filter(|call| call.name == web_search::INTERNAL_TOOL_NAME)
+            .collect();
+        if server_calls.is_empty() {
+            terminal_callback(&completion)?;
+            return Ok(completion);
+        }
+
+        let client_calls_present = completion
+            .tool_calls
+            .iter()
+            .any(|call| call.name != web_search::INTERNAL_TOOL_NAME);
+        if client_calls_present {
+            for call in &server_calls {
+                let server_id = format!("srvtoolu_{}_{}", id_suffix(&root_id), search_index);
+                search_index += 1;
+                let server_tool_use = serde_json::json!({
+                    "type":"server_tool_use", "id":server_id,
+                    "name":"web_search", "input":call.arguments
+                });
+                server_blocks
+                    .lock()
+                    .unwrap_or_else(|error| error.into_inner())
+                    .push(server_tool_use.clone());
+                event_callback(&serde_json::json!({
+                    "type":"hipfire_server_tool_block", "block":server_tool_use
+                }))?;
+            }
+            let mut completion = completion;
+            completion
+                .tool_calls
+                .retain(|call| call.name != web_search::INTERNAL_TOOL_NAME);
+            terminal_callback(&completion)?;
+            return Ok(completion);
+        }
+        let mut internal_tool_calls = Vec::with_capacity(server_calls.len());
+        let mut internal_tool_results = Vec::with_capacity(server_calls.len());
+        for call in &server_calls {
+            let call_id = call
+                .id
+                .clone()
+                .unwrap_or_else(|| format!("hipfire_web_search_{search_index}"));
+            let server_id = format!("srvtoolu_{}_{}", id_suffix(&root_id), search_index);
+            search_index += 1;
+            let output = if search_uses >= max_uses {
+                web_search::max_uses_exceeded(&server_id, &call.arguments)
+            } else {
+                search_uses += 1;
+                web_search::execute(&server_id, &call.arguments, &config, request_key)
+            };
+            {
+                let mut blocks = server_blocks
+                    .lock()
+                    .unwrap_or_else(|error| error.into_inner());
+                blocks.push(output.server_tool_use.clone());
+                blocks.push(output.result_block.clone());
+            }
+            event_callback(&serde_json::json!({
+                "type":"hipfire_server_tool_block", "block":output.server_tool_use
+            }))?;
+            event_callback(&serde_json::json!({
+                "type":"hipfire_server_tool_block", "block":output.result_block
+            }))?;
+            internal_tool_calls.push(serde_json::json!({
+                "id":call_id,
+                "type":"function",
+                "function":{"name":web_search::INTERNAL_TOOL_NAME,
+                    "arguments":call.arguments.to_string()}
+            }));
+            internal_tool_results.push((call_id, output.model_result));
+        }
+
+        let messages = body
+            .get_mut("messages")
+            .and_then(serde_json::Value::as_array_mut)
+            .ok_or_else(|| anyhow!("native web search request lost its message history"))?;
+        messages.push(serde_json::json!({
+            "role":"assistant",
+            "content":completion.content,
+            "tool_calls":internal_tool_calls
+        }));
+        for (tool_call_id, result) in internal_tool_results {
+            messages.push(serde_json::json!({
+                "role":"tool", "tool_call_id":tool_call_id, "content":result
+            }));
+        }
+        if search_uses >= max_uses {
+            if let Some(tools) = body
+                .get_mut("tools")
+                .and_then(serde_json::Value::as_array_mut)
+            {
+                tools.retain(|tool| {
+                    tool.pointer("/function/name")
+                        .and_then(serde_json::Value::as_str)
+                        != Some(web_search::INTERNAL_TOOL_NAME)
+                });
+            }
+            if body.get("tool_choice").and_then(serde_json::Value::as_str) == Some("required")
+                || body
+                    .pointer("/tool_choice/function/name")
+                    .and_then(serde_json::Value::as_str)
+                    == Some(web_search::INTERNAL_TOOL_NAME)
+            {
+                body["tool_choice"] = serde_json::Value::String("auto".into());
+            }
+        }
+        next_guard = Some(shared.admission.acquire_for_with_bytes(
+            eligible,
+            model.as_deref(),
+            0,
+        )?);
+    }
+}
