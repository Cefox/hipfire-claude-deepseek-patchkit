+/// Read-only prompt projection for the resident singleton model. Called under
+/// exclusive admission on a blocking worker; it never loads, resets or swaps a
+/// model, and the daemon counts with a private copy of its history cache.
+pub(crate) fn count_tokens_request(
+    shared: &ServeShared,
+    body: &serde_json::Value,
+) -> Result<serde_json::Value> {
+    let model = body
+        .get("model")
+        .and_then(serde_json::Value::as_str)
+        .ok_or_else(|| invalid_request!("model is required"))?;
+    if request_image_base64(body.get("messages"))?.is_some() {
+        bail_invalid!("count_tokens currently supports text input only");
+    }
+    let (engine, request) = {
+        let runtime = shared.runtime.lock().unwrap_or_else(|e| e.into_inner());
+        if runtime.multi_slot_enabled {
+            bail_invalid!("count_tokens is not supported on the experimental multi-slot route");
+        }
+        let current = runtime.current_path.as_ref().ok_or_else(|| {
+            invalid_request!("count_tokens requires a resident model; start serve with --model")
+        })?;
+        // Resolve installed names without downloads, checksum migration, or an
+        // implicit model load. Counting one model must not evict another chat.
+        let path = crate::find_model_path(&runtime.paths, &runtime.registry, model)
+            .and_then(|p| std::fs::canonicalize(p).ok());
+        if path.as_ref() != std::fs::canonicalize(current).ok().as_ref() || path.is_none() {
+            bail_invalid!(
+                "count_tokens requires the requested model to be resident; model switching is disabled for counting"
+            );
+        }
+        let (tag, entry) = crate::registry_entry_for_path(&runtime.paths, &runtime.registry, model)
+            .map(|(tag, entry)| (Some(tag), Some(entry)))
+            .unwrap_or((None, None));
+        let resolved = crate::resolved_for_model(&runtime.paths, model, tag, entry)?;
+        let contract = project_request_contract(
+            body,
+            &resolved,
+            include_reasoning_content(runtime.current_arch.as_deref()),
+            false,
+        )?;
+        let mut request = serde_json::json!({
+            "type":"count_tokens", "id":request_id(),
+            "prompt":last_user_prompt(&contract.messages).unwrap_or_else(|| "Hello".into()),
+            "messages":contract.messages,
+        });
+        if let Some(tools) = contract.forwarded_tools {
+            request["tools"] = tools;
+        }
+        apply_http_reasoning_request(
+            body,
+            &resolved,
+            &mut request,
+            runtime.current_reasoning_contract,
+            runtime.current_reasoning_effort_native,
+            &runtime.current_reasoning_efforts,
+        )?;
+        (runtime.engine.clone(), request)
+    };
+    let reply = engine.request(&request)?;
+    if reply.get("type").and_then(serde_json::Value::as_str) == Some("error") {
+        return Err(hipfire_client::daemon_error_from_value(&reply).into());
+    }
+    if reply.get("type").and_then(serde_json::Value::as_str) != Some("token_count")
+        || reply.get("id") != request.get("id")
+    {
+        bail!("invalid count_tokens daemon response");
+    }
+    let tokens = reply
+        .get("input_tokens")
+        .and_then(serde_json::Value::as_u64)
+        .ok_or_else(|| anyhow!("count_tokens daemon response has no input_tokens"))?;
+    Ok(serde_json::json!({"input_tokens":tokens}))
+}
