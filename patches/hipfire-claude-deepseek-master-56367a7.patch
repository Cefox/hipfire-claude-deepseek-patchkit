+/// Accept Claude Code's inline system updates without changing the official
+/// Qwen4 template's leading-system, tool, or thinking branches. Unknown and
+/// user-overridden templates are left untouched.
+fn qwen4_inline_system_template(template: String) -> String {
+    const ORIGINAL: &str = r#"    {%- if message.role == "system" %}
+        {%- if not loop.first %}
+            {{- raise_exception('System message must be at the beginning.') }}
+        {%- endif %}
+    {%- elif message.role == "user" %}
+        {{- '<|im_start|>' + message.role + '\n' + content + '<|im_end|>' + '\n' }}"#;
+    const ADAPTED: &str = r#"    {%- if message.role == "system" %}
+        {%- if not loop.first %}
+            {{- '<|im_start|>system\n' + content + '<|im_end|>\n' }}
+        {%- endif %}
+    {%- elif message.role == "user" %}
+        {{- '<|im_start|>' + message.role + '\n' + content + '<|im_end|>' + '\n' }}"#;
+    const LOOP: &str = "{%- for message in messages %}\n    {%- set content = render_content(message.content, true)|trim %}";
+    if template.matches(ORIGINAL).count() != 1
+        || template
+            .matches("System message must be at the beginning.")
+            .count()
+            != 1
+        || template.matches(LOOP).count() != 1
+    {
+        return template;
+    }
+    template.replacen(ORIGINAL, ADAPTED, 1)
+}
