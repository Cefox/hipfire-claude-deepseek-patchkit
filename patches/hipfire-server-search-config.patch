+/// Server-owned settings. Debug redacts the credential via BearerToken.
+#[derive(Debug)]
+pub(crate) struct SearchSettings {
+    api_key: Option<hipfire_config::secret::BearerToken>,
+    url: String,
+}
+
+impl SearchSettings {
+    pub(crate) fn from_config(config: &hipfire_config::ResolvedConfig) -> anyhow::Result<Self> {
+        Self::from_values(
+            &crate::config_string(config, "serve.deepseek_api_key_file")?,
+            &crate::config_string(config, "serve.deepseek_search_url")?,
+        )
+    }
+
+    pub(crate) fn from_values(key_file: &str, url: &str) -> anyhow::Result<Self> {
+        let uri: ureq::http::Uri = url.parse().map_err(|_| {
+            anyhow::anyhow!("serve.deepseek_search_url must be an absolute HTTPS URL")
+        })?;
+        let loopback = matches!(
+            uri.host(),
+            Some("localhost" | "127.0.0.1" | "::1" | "[::1]")
+        );
+        if uri.host().is_none()
+            || uri.authority().is_some_and(|a| a.as_str().contains('@'))
+            || !(uri.scheme_str() == Some("https")
+                || (uri.scheme_str() == Some("http") && loopback))
+        {
+            anyhow::bail!("serve.deepseek_search_url requires HTTPS (HTTP is allowed only for loopback tests)");
+        }
+        let api_key = if key_file.is_empty() {
+            None
+        } else {
+            Some(
+                hipfire_config::secret::BearerToken::load(std::path::Path::new(key_file))
+                    .map_err(|error| anyhow::anyhow!("serve.deepseek_api_key_file: {error}"))?,
+            )
+        };
+        Ok(Self {
+            api_key,
+            url: url.to_owned(),
+        })
+    }
+
+    pub(crate) fn is_configured(&self) -> bool {
+        self.api_key.is_some()
+    }
 }
 
